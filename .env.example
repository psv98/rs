# Copy to .env and adjust. Never commit the real .env.

# Public base URL of the site (used for canonical URLs, hreflang, sitemap, Open Graph).
SITE_URL=http://localhost:3000

# Database.
#   SQLite (local):     file:./var/imi.db
#   PostgreSQL (prod):  postgres://imi_app:CHANGE_ME@db-host:5432/imi?sslmode=require
DATABASE_URL=file:./var/imi.db

# Where automatic JSON backups are written after every publication change.
BACKUP_DIR=./backups

# Set to 1 only when the app runs behind a reverse proxy you control
# (nginx, Caddy, a PaaS router) that sets X-Forwarded-For. Used for login throttling.
TRUST_PROXY=0

# Admin session lifetime (minutes).
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_MINUTES=720
