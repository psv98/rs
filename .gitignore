backups/

# test & QA artefacts
coverage/
tests/.tmp/
qa/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
npm-debug.log*

# static build artefacts (generated in CI)
out/
public/exports/
